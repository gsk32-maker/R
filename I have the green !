-- تفعيل فارم الـ ATM
AtmButton.MouseButton1Click:Connect(function()
    atmFarming = not atmFarming
    if atmFarming then
        AtmButton.Text = "ATM Farm: ON"
        AtmButton.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
    else
